{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.jotavictor.com"
        }
      ],
      "destination": "https://jotavictor.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "jotavictor-site.vercel.app"
        }
      ],
      "destination": "https://jotavictor.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "jotavictor-site-jotaai.vercel.app"
        }
      ],
      "destination": "https://jotavictor.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "jotavictor-site-git-master-jotaai.vercel.app"
        }
      ],
      "destination": "https://jotavictor.com/$1",
      "permanent": true
    }
  ]
}
