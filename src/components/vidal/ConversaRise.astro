---
// Conversa de demonstração do Rise no WhatsApp. DADOS FICTÍCIOS.
import CartaoMeta from './CartaoMeta.astro';
interface Props { animar?: boolean }
const { animar = true } = Astro.props;
---
<div class:list={['conversa', { animar }]} role="img" aria-label="Demonstração com dados fictícios: a gestão pergunta pelo WhatsApp como está a meta da loja e o assistente Rise responde com o cartão da meta e uma sugestão de compra para revisão.">
  <div class="cv-topo">
    <span class="cv-avatar">R</span>
    <div><strong>Rise</strong><small>assistente da rede · online</small></div>
  </div>
  <div class="cv-corpo">
    <p class="cv-dia">Hoje</p>
    <div class="bolha eu" style="--i:0">Como tá a meta da Loja Centro?<time>08:12</time></div>
    <div class="bolha ele" style="--i:1">
      Bom dia! Até ontem a Loja Centro vendeu R$ 59.850 e, no ritmo atual, fecha o mês em 95%.
      <div class="cv-cartao"><CartaoMeta compacto /></div>
      <time>08:12</time>
    </div>
    <div class="bolha eu" style="--i:2">Monta a sugestão de compra de fraldas pra semana.<time>08:14</time></div>
    <div class="bolha ele" style="--i:3">
      <span class="cv-arquivo"><b>XLSX</b>sugestao-compra-centro.xlsx</span>
      Pronto: 18 itens para revisão. Nada é pedido sem o seu ok.<time>08:15</time>
    </div>
  </div>
</div>

<style>
  .conversa { height: 100%; display: flex; flex-direction: column; background: #0d1418; font-family: var(--sans); color: #e9edef; }
  .cv-topo { display: flex; align-items: center; gap: 10px; padding: 34px 14px 10px; background: #1f2c33; }
  .cv-avatar { width: 32px; height: 32px; border-radius: 50%; display: grid; place-items: center; background: var(--champagne); color: #0b0b0b; font-weight: 700; font-size: 15px; }
  .cv-topo strong { display: block; font-size: 14px; line-height: 1.1; }
  .cv-topo small { display: block; font-size: 10.5px; color: #8696a0; }
  .cv-corpo { flex: 1; padding: 10px 10px 14px; display: flex; flex-direction: column; gap: 7px; overflow: hidden;
    background-image: radial-gradient(rgb(255 255 255 / 0.025) 1px, transparent 1px); background-size: 14px 14px; }
  .cv-dia { align-self: center; font-size: 10px; background: #1f2c33; color: #8696a0; padding: 3px 9px; border-radius: 7px; }
  .bolha { max-width: 86%; padding: 7px 9px 16px; border-radius: 10px; font-size: 12px; line-height: 1.38; position: relative; }
  .bolha time { position: absolute; right: 8px; bottom: 3px; font-size: 9px; color: rgb(233 237 239 / 0.78); }
  .eu { align-self: flex-end; background: #005c4b; border-top-right-radius: 3px; }
  .ele { align-self: flex-start; background: #1f2c33; border-top-left-radius: 3px; }
  .cv-cartao { margin: 7px 0 2px; width: 100%; }
  .cv-arquivo { display: flex; align-items: center; gap: 8px; background: rgb(0 0 0 / 0.25); border-radius: 7px; padding: 7px 8px; margin-bottom: 6px; font-size: 11px; }
  .cv-arquivo b { font-size: 9px; background: #1d7a45; color: #fff; border-radius: 4px; padding: 3px 4px; }
  .animar .bolha { animation: cv-entrar 0.7s var(--ease) both; animation-delay: calc(0.9s + var(--i) * 0.75s); }
  @keyframes cv-entrar { from { opacity: 0; transform: translateY(12px) scale(0.96); } }
</style>
