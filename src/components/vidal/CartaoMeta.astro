---
// Recriação do cartão diário do Rise com DADOS FICTÍCIOS. Nenhum número real da rede.
interface Props { compacto?: boolean }
const { compacto = false } = Astro.props;
const linhas = [
  ['Meta do mês', 'R$ 90.000,00'],
  ['Valor realizado', 'R$ 59.850,00'],
  ['Valor restante', 'R$ 30.150,00'],
  ['Média diária obtida', 'R$ 2.850,00'],
  ['Média diária necessária', 'R$ 3.350,00'],
  ['Projeção de fechamento', 'R$ 85.500,00'],
  ['Margem do mês', '41,20%'],
];
---
<div class:list={['cartao-meta', { compacto }]} role="img" aria-label="Cartão de meta diária de uma loja, com dados fictícios: 59.850 reais vendidos de uma meta de 90 mil, projeção de 95 por cento.">
  <div class="cm-topo">
    <span class="cm-selo">Rede Vidal</span>
    <div><strong>LOJA CENTRO</strong><small>Até 21/11 · dia 21 de 30</small></div>
  </div>
  <div class="cm-valor">
    <div><strong>R$ 59.850,00</strong><small>Meta realizada: 66,50%</small></div>
    <span class="cm-pct">95,00%</span>
  </div>
  <div class="cm-barra"><i></i></div>
  {!compacto && (
    <table>
      <thead><tr><th>Indicador</th><th>Valor</th></tr></thead>
      <tbody>{linhas.map(([a, b]) => <tr><td>{a}</td><td>{b}</td></tr>)}</tbody>
    </table>
  )}
  <p class="cm-analise"><b>Análise:</b> a loja precisa elevar a média diária em cerca de <b>R$ 500,00</b> para alcançar a meta.</p>
  <p class="cm-fonte">Dados fictícios para demonstração</p>
</div>

<style>
  .cartao-meta { background: #fbfbfa; color: #0b1a6e; border-radius: 16px; padding: 18px 18px 14px; font-family: var(--sans); box-shadow: 0 40px 80px -30px rgb(0 0 0 / 0.75); width: 100%; }
  .cm-topo { display: flex; align-items: center; gap: 12px; }
  .cm-selo { flex: none; border: 1px solid #d5d7e2; border-radius: 10px; padding: 7px 10px; font: 700 12px/1 var(--sans); color: #1630b8; letter-spacing: -0.01em; }
  .cm-topo strong { display: block; font-size: 19px; font-weight: 800; letter-spacing: -0.02em; line-height: 1; }
  .cm-topo small { display: block; font-size: 12px; color: #33407a; margin-top: 4px; }
  .cm-valor { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-top: 14px; }
  .cm-valor strong { display: block; font-size: 24px; font-weight: 800; letter-spacing: -0.03em; line-height: 1.05; }
  .cm-valor small { color: #6b6f80; font-size: 12px; }
  .cm-pct { background: #b84f0a; color: #fff; font-weight: 800; font-size: 17px; padding: 8px 12px; border-radius: 12px; letter-spacing: -0.02em; }
  .cm-barra { height: 9px; border-radius: 9px; background: #e6e6e4; margin: 12px 0 12px; overflow: hidden; }
  .cm-barra i { display: block; height: 100%; width: 66.5%; background: #ef7418; border-radius: inherit; transform-origin: left; animation: cm-encher 1.6s var(--ease) both; animation-delay: 0.4s; }
  table { width: 100%; border-collapse: collapse; font-size: 12.5px; }
  th { background: #1630b8; color: #fff; text-align: left; padding: 6px 10px; font-weight: 700; }
  th:first-child { border-radius: 8px 0 0 8px; } th:last-child { border-radius: 0 8px 8px 0; }
  td { padding: 5px 10px; border-bottom: 1px solid #dfe0e6; font-weight: 600; }
  td:last-child { font-variant-numeric: tabular-nums; white-space: nowrap; }
  @media (max-width: 600px) { .cartao-meta:not(.compacto) { padding: 14px; } .cartao-meta:not(.compacto) table { font-size: 11.5px; } .cartao-meta:not(.compacto) td { padding: 4px 8px; } }
  .cm-analise { font-size: 12.5px; margin-top: 10px; line-height: 1.45; color: #13205f; }
  .cm-fonte { font: 500 10px/1 var(--mono); color: #5f6270; margin-top: 10px; letter-spacing: 0.04em; text-transform: uppercase; }
  .compacto { padding: 12px 12px 10px; border-radius: 12px; }
  .compacto .cm-topo strong { font-size: 14px; }
  .compacto .cm-topo small { font-size: 10px; }
  .compacto .cm-selo { display: none; }
  .compacto .cm-valor strong { font-size: 17px; }
  .compacto .cm-valor small { font-size: 10px; }
  .compacto .cm-pct { font-size: 12.5px; padding: 5px 8px; border-radius: 9px; }
  .compacto .cm-barra { height: 7px; margin: 9px 0 6px; }
  .compacto .cm-analise { font-size: 10.5px; margin-top: 6px; }
  .compacto .cm-fonte { font-size: 8.5px; margin-top: 7px; }
  @keyframes cm-encher { from { transform: scaleX(0.08); } }
</style>
