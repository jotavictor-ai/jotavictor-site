---
import { contato } from '../data/site';
const ano = new Date().getFullYear();
---
<footer class="rodape">
  <div class="wrap">
    <span><strong style="color:var(--ivory);font-weight:600">jotavictor.</strong> Soluções digitais e IA · Natal, RN</span>
    <nav aria-label="Rodapé">
      <a href={contato.whatsapp} target="_blank" rel="noopener">WhatsApp</a>
      <a href={`mailto:${contato.email}`}>{contato.email}</a>
      <a href={contato.github} target="_blank" rel="noopener">GitHub</a>
      <a href={contato.instagramFit} target="_blank" rel="noopener">@jotav.fit</a>
      <span>© {ano}</span>
    </nav>
  </div>
</footer>
