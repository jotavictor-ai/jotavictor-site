---
import { getCollection } from 'astro:content';
import VisualCase from './VisualCase.astro';
import Seta from './Seta.astro';
const trabalhos = (await getCollection('trabalhos', ({ data }) => data.visivel)).sort((a, b) => a.data.ordem - b.data.ordem);
---
<section id="trabalhos" class="secao trabalhos" aria-labelledby="trabalhos-titulo">
  <div class="wrap">
    <header class="sec-cabeca">
      <p class="eyebrow">Trabalhos</p>
      <h2 id="trabalhos-titulo">Projetos reais, <em class="acento">para clientes reais.</em></h2>
      <p>Uma rede de farmácias, uma instituição empresarial e um especialista. Problemas diferentes, a mesma forma de trabalhar.</p>
    </header>
  </div>
  {trabalhos.map((t, i) => (
    <article class:list={['case', { invertido: i % 2 === 1 }]} id={`case-${t.id}`} aria-labelledby={`t-${t.id}`}>
      <div class="wrap case-grade">
        <div class="case-texto">
          <div class="case-meta">
            <span class="case-num">{String(i + 1).padStart(2, '0')}</span>
            <span class="mono">{t.data.categoria}</span>
          </div>
          <h3 id={`t-${t.id}`}>{t.data.cliente}</h3>
          <p class="case-chamada">{t.data.chamada}</p>
          <p class="case-resumo">{t.data.resumo}</p>
          <ul class="case-tags" aria-label="O que foi feito">{t.data.tags.map((tag) => <li>{tag}</li>)}</ul>
          <div class="case-rodape">
            <span class:list={['selo', { vivo: t.data.selo === 'Em operação' }]}>{t.data.selo}</span>
            <a class="link-seta" href={`/trabalhos/${t.id}/`}>Ver o case<Seta /></a>
          </div>
        </div>
        <a class="case-visual" href={`/trabalhos/${t.id}/`} tabindex="-1" aria-hidden="true">
          <VisualCase trabalho={t} />
        </a>
      </div>
    </article>
  ))}
</section>

<style>
  .trabalhos { padding-bottom: clamp(40px, 6vw, 80px); }
  .case { padding: clamp(48px, 7vw, 96px) 0; border-top: 1px solid var(--line); }
  .case-grade { display: grid; grid-template-columns: minmax(0, 4.2fr) minmax(0, 7.8fr); gap: clamp(32px, 5vw, 80px); align-items: center; }
  .invertido .case-grade { grid-template-columns: minmax(0, 7.8fr) minmax(0, 4.2fr); }
  .invertido .case-texto { order: 2; }
  .case-texto { display: grid; gap: 18px; align-content: center; }
  .case-meta { display: flex; align-items: baseline; gap: 16px; color: var(--champagne); }
  .case-num { font: 400 15px/1 var(--mono); color: var(--muted-2); }
  .case h3 { font-size: clamp(2.6rem, 5.2vw, 4.6rem); letter-spacing: -0.05em; }
  .case-chamada { font-family: var(--serif); font-style: italic; font-size: clamp(21px, 2.1vw, 27px); line-height: 1.25; color: var(--ivory); }
  .case-resumo { color: var(--muted); }
  .case-tags { list-style: none; margin: 4px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .case-tags li { font-size: 13px; padding: 6px 12px; border: 1px solid var(--line-2); border-radius: 999px; color: var(--muted); }
  .case-rodape { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-top: 10px; }
  .selo { font: 500 11px/1 var(--mono); letter-spacing: 0.14em; text-transform: uppercase; color: var(--champagne); display: inline-flex; align-items: center; gap: 8px; }
  .selo::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: currentColor; }
  .selo.vivo::before { background: #5fd18b; box-shadow: 0 0 0 0 rgb(95 209 139 / 0.6); animation: pulso 2.2s ease-out infinite; }
  @keyframes pulso { to { box-shadow: 0 0 0 9px rgb(95 209 139 / 0); } }
  .case-visual { display: block; text-decoration: none; color: inherit; }

  /* A tela cresce e se abre ao entrar na vista */
  @supports (animation-timeline: view()) {
    .case-visual { animation-name: case-abre; animation-timing-function: linear; animation-fill-mode: both; animation-duration: auto; }
    .case-grade > .case-visual { animation-timeline: view(); animation-range: entry 0% cover 42%; }
    @keyframes case-abre { from { transform: translateY(70px) scale(0.9); clip-path: inset(8% 6% 8% 6% round 24px); } to { transform: none; clip-path: inset(-10% -10% -10% -10%); } }
  }

  @media (max-width: 900px) {
    .case-grade, .invertido .case-grade { grid-template-columns: 1fr; }
    .invertido .case-texto { order: 0; }
    .case-visual { order: -1; margin-bottom: 8px; }
  }
</style>
