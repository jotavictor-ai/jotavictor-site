---
import IconeZap from './IconeZap.astro';
import { whatsappCom } from '../data/site';
const opcoes = [
  { id: 'presenca', aba: 'Presença digital', titulo: 'Transforme visitas em contatos.', texto: 'Sites que apresentam a empresa, organizam a informação e facilitam a contratação.', ref: 'CDL Balsas · Victor Oliveira' },
  { id: 'ia', aba: 'Inteligência artificial', titulo: 'IA trabalhando na sua rotina.', texto: 'Assistentes que consultam seus dados, respondem pelo WhatsApp e preparam o trabalho repetitivo. A decisão continua com você.', ref: 'Rede Vidal' },
  { id: 'sistemas', aba: 'Sistemas sob medida', titulo: 'Ferramentas do jeito que a sua operação funciona.', texto: 'Catálogos, painéis e sistemas internos para vender, organizar e acompanhar.', ref: 'CatálogoZap' },
];
const zap = whatsappCom('Oi, João! Vim pelo jotavictor.com. Meu desafio é: ');
---
<section id="desafios" class="secao desafios" aria-labelledby="desafios-titulo">
  <div class="wrap">
    <header class="sec-cabeca">
      <p class="eyebrow">O que posso construir</p>
      <h2 id="desafios-titulo">Qual é o desafio do <em class="acento">seu negócio?</em></h2>
    </header>
    <div class="abas" data-abas>
      <div class="abas-lista" role="tablist" aria-label="Desafios">
        {opcoes.map((o, i) => (
          <button type="button" role="tab" id={`aba-${o.id}`} aria-controls={`painel-${o.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
            <span class="mono">0{i + 1}</span>{o.aba}
          </button>
        ))}
      </div>
      {opcoes.map((o) => (
        <div class="painel" role="tabpanel" id={`painel-${o.id}`} aria-labelledby={`aba-${o.id}`} tabindex="0">
          <div class="painel-texto">
            <h3>{o.titulo}</h3>
            <p>{o.texto}</p>
            <p class="painel-ref mono">Referência: <span>{o.ref}</span></p>
          </div>
          <div class="demo" aria-hidden="true">
            {o.id === 'presenca' && (
              <div class="d-site">
                <div class="d-barra"><i></i><i></i><i></i></div>
                <div class="d-pagina">
                  <span class="d-logo"></span>
                  <span class="d-linha l1"></span><span class="d-linha l2"></span><span class="d-linha l3"></span>
                  <span class="d-botao">Fale conosco</span>
                  <div class="d-blocos"><span></span><span></span><span></span></div>
                </div>
                <div class="d-aviso"><b>Novo contato</b>pelo site · agora</div>
              </div>
            )}
            {o.id === 'ia' && (
              <div class="d-chat">
                <div class="d-msg eu" style="--i:0">Quanto vendemos ontem?</div>
                <div class="d-msg ele" style="--i:1">R$ 12.480 nas 3 lojas. A loja 2 puxou a média.</div>
                <div class="d-msg eu" style="--i:2">E o que precisa repor?</div>
                <div class="d-msg ele" style="--i:3">Separei 14 itens. Mando a planilha para você aprovar?</div>
                <div class="d-digitando" style="--i:4"><i></i><i></i><i></i></div>
              </div>
            )}
            {o.id === 'sistemas' && (
              <div class="d-sistema">
                <div class="d-grade">
                  {[1, 2, 3, 4, 5, 6].map((n) => <div class="d-item" style={`--i:${n}`}><span class="d-img"></span><span class="d-nome"></span><span class="d-preco">R$ {n * 7},90</span></div>)}
                </div>
                <div class="d-carrinho"><span>Pedido · 3 itens</span><b>Enviar no WhatsApp</b></div>
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
    <p class="desafios-cta"><a class="btn btn-primario" href={zap} target="_blank" rel="noopener"><IconeZap />Contar meu desafio no WhatsApp</a></p>
    <p class="desafios-nota mono">Demonstrações ilustrativas</p>
  </div>
</section>

<style>
  .desafios { background: var(--carbon-2); border-block: 1px solid var(--line); }
  .abas-lista { display: none; }
  .painel { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: clamp(28px, 5vw, 72px); align-items: center; padding: clamp(28px, 4vw, 48px); border: 1px solid var(--line); border-radius: 26px; background: var(--carbon); }
  .painel + .painel { margin-top: 16px; }
  .painel h3 { font-size: clamp(1.9rem, 3.4vw, 3rem); letter-spacing: -0.04em; }
  .painel-texto { display: grid; gap: 18px; }
  .painel-texto > p:not(.painel-ref) { color: var(--muted); font-size: 18px; max-width: 42ch; }
  .painel-ref { color: var(--muted-2); font-size: 11px; letter-spacing: 0.1em; line-height: 1.7; }
  .painel-ref span { color: var(--champagne); }
  .painel[hidden] { display: none; }
  :global(html.js) .abas-lista { display: flex; gap: 8px; margin-bottom: 18px; overflow-x: auto; scrollbar-width: none; padding: 2px; }
  :global(html.js) .painel + .painel { margin-top: 0; }
  :global(html.js) .abas:not(.abas-prontas) .painel ~ .painel { display: none; }
  [role='tab'] { flex: none; display: inline-flex; align-items: center; gap: 12px; min-height: 52px; padding: 0 22px; border-radius: 999px; border: 1px solid var(--line-2); background: transparent; color: var(--muted); font: 550 15.5px/1 var(--sans); cursor: pointer; transition: background-color 0.3s, color 0.3s, border-color 0.3s; }
  [role='tab'] .mono { font-size: 11px; color: var(--muted-2); }
  [role='tab']:hover { color: var(--ivory); border-color: var(--champagne); }
  [role='tab'][aria-selected='true'] { background: var(--ivory); color: var(--carbon); border-color: var(--ivory); }
  [role='tab'][aria-selected='true'] .mono { color: #6e5326; }
  .desafios-cta { margin-top: 36px; display: flex; justify-content: center; }
  .desafios-nota { text-align: center; color: var(--muted-2); font-size: 10.5px; margin-top: 14px; }

  /* Demonstrações */
  .demo { position: relative; aspect-ratio: 4 / 3; border-radius: 18px; background: var(--graphite); border: 1px solid var(--line); overflow: hidden; display: grid; place-items: center; padding: 7%; }
  .d-site { width: 100%; height: 100%; background: #f5f3ef; border-radius: 12px; overflow: hidden; position: relative; display: flex; flex-direction: column; }
  .d-barra { display: flex; gap: 5px; padding: 9px 11px; background: #e6e2da; }
  .d-barra i { width: 7px; height: 7px; border-radius: 50%; background: #c6c0b4; }
  .d-pagina { padding: 7% 8%; display: grid; gap: 10px; justify-items: start; }
  .d-logo { width: 54px; height: 10px; border-radius: 4px; background: #0b0b0b; }
  .d-linha { height: 14px; border-radius: 5px; background: #1a1a1a; transform-origin: left; animation: d-cresce 1.1s var(--ease) both; }
  .l1 { width: 82%; animation-delay: 0.2s; margin-top: 8px; } .l2 { width: 64%; animation-delay: 0.35s; } .l3 { width: 40%; height: 8px; background: #a8a296; animation-delay: 0.5s; }
  .d-botao { margin-top: 6px; font: 600 11px/1 var(--sans); background: var(--champagne); color: #0b0b0b; padding: 9px 14px; border-radius: 999px; animation: d-pulso 2.4s ease-in-out infinite 1.4s; }
  .d-blocos { width: 100%; display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-top: 10px; }
  .d-blocos span { height: 44px; border-radius: 8px; background: #e6e2da; animation: d-sobe 0.9s var(--ease) both; }
  .d-blocos span:nth-child(2) { animation-delay: 0.12s; } .d-blocos span:nth-child(3) { animation-delay: 0.24s; }
  .d-aviso { position: absolute; right: 6%; bottom: 7%; background: #0b0b0b; color: #f5f3ef; font-size: 11px; padding: 10px 14px; border-radius: 12px; display: grid; gap: 2px; box-shadow: 0 16px 30px -12px rgb(0 0 0 / 0.5); animation: d-aviso 5s var(--ease) infinite 1.6s; }
  .d-aviso b { color: var(--champagne); font-size: 12px; }
  .d-chat { width: 100%; display: grid; gap: 9px; }
  .d-msg { max-width: 80%; padding: 10px 13px; border-radius: 14px; font-size: 13px; line-height: 1.35; animation: d-msg 0.6s var(--ease) both; animation-delay: calc(0.3s + var(--i) * 0.7s); }
  .d-msg.eu { justify-self: end; background: #005c4b; border-bottom-right-radius: 4px; }
  .d-msg.ele { justify-self: start; background: #2a2a28; border-bottom-left-radius: 4px; }
  .d-digitando { justify-self: start; display: flex; gap: 4px; padding: 12px 14px; background: #2a2a28; border-radius: 14px; animation: d-msg 0.6s var(--ease) both; animation-delay: calc(0.3s + var(--i) * 0.7s); }
  .d-digitando i { width: 6px; height: 6px; border-radius: 50%; background: var(--muted); animation: d-ponto 1.2s ease-in-out infinite; }
  .d-digitando i:nth-child(2) { animation-delay: 0.15s; } .d-digitando i:nth-child(3) { animation-delay: 0.3s; }
  .d-sistema { width: 100%; height: 100%; display: grid; grid-template-rows: 1fr auto; gap: 12px; }
  .d-grade { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .d-item { background: #f5f3ef; border-radius: 10px; padding: 8px; display: grid; gap: 6px; align-content: start; animation: d-sobe 0.8s var(--ease) both; animation-delay: calc(var(--i) * 0.08s); }
  .d-img { aspect-ratio: 1.4; border-radius: 6px; background: #e3ddd1; }
  .d-nome { height: 6px; width: 70%; border-radius: 3px; background: #b9b2a5; }
  .d-preco { font: 700 11px/1 var(--sans); color: #0b0b0b; }
  .d-item:nth-child(2), .d-item:nth-child(4), .d-item:nth-child(6) { box-shadow: 0 0 0 2px var(--champagne); animation: d-sobe 0.8s var(--ease) both, d-escolhe 0.5s var(--ease) both; animation-delay: calc(var(--i) * 0.08s), calc(0.9s + var(--i) * 0.25s); }
  .d-carrinho { display: flex; justify-content: space-between; align-items: center; gap: 10px; background: var(--champagne); color: #0b0b0b; border-radius: 12px; padding: 12px 14px; font-size: 12.5px; animation: d-sobe 0.8s var(--ease) both 2.2s; }
  @keyframes d-cresce { from { transform: scaleX(0); } }
  @keyframes d-sobe { from { transform: translateY(18px); opacity: 0; } }
  @keyframes d-msg { from { transform: translateY(10px) scale(0.96); opacity: 0; } }
  @keyframes d-ponto { 50% { transform: translateY(-3px); opacity: 0.5; } }
  @keyframes d-pulso { 50% { box-shadow: 0 0 0 6px rgb(201 169 110 / 0.25); } }
  @keyframes d-escolhe { from { box-shadow: 0 0 0 0 var(--champagne); } }
  @keyframes d-aviso { 0%, 8% { transform: translateY(140%); } 16%, 80% { transform: none; } 92%, 100% { transform: translateY(140%); } }

  @media (max-width: 900px) {
    .painel { grid-template-columns: 1fr; padding: 22px; }
    .demo { order: -1; }
  }
  @media (max-width: 480px) {
    .d-msg { font-size: 11.5px; }
    .d-grade { gap: 7px; }
  }
</style>
