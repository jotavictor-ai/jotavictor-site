---
import { Image } from 'astro:assets';
import IconeZap from './IconeZap.astro';
import ConversaRise from './vidal/ConversaRise.astro';
import { contato } from '../data/site';
import cdl from '../assets/trabalhos/cdl-balsas/home-desktop.png';
import vo2 from '../assets/trabalhos/victor-oliveira/home-desktop.png';
---
<section class="hero" data-hero aria-labelledby="hero-titulo">
  <div class="hero-luz" aria-hidden="true"></div>
  <div class="wrap hero-texto">
    <p class="eyebrow">Estúdio independente de tecnologia · Natal, Brasil</p>
    <h1 id="hero-titulo">Eu construo o que o seu negócio <em class="acento">precisa.</em></h1>
    <div class="hero-linha">
      <p class="hero-sub">Sites, sistemas e inteligência artificial. Do problema real à solução funcionando.</p>
      <div class="hero-acoes">
        <a class="btn btn-primario" href="#trabalhos">Ver trabalhos</a>
        <a class="btn btn-linha" href={contato.whatsapp} target="_blank" rel="noopener"><IconeZap />Chamar no WhatsApp</a>
      </div>
    </div>
  </div>

  <div class="palco">
    <a class="tela tela-esq" href="#case-cdl-balsas" tabindex="-1" aria-hidden="true">
      <div class="tela-in">
        <div class="browser"><div class="browser-barra"><i></i><i></i><i></i><span>CDL Balsas</span></div>
          <Image src={cdl} alt="Site da CDL Balsas" widths={[480, 760, 1100]} sizes="(max-width: 900px) 60vw, 38vw" loading="eager" />
        </div>
        <span class="tela-rotulo mono">CDL Balsas</span>
      </div>
    </a>
    <a class="tela tela-centro" href="#case-rede-vidal" tabindex="-1" aria-hidden="true">
      <div class="tela-in">
        <div class="phone"><div class="phone-tela"><ConversaRise /></div></div>
        <span class="tela-rotulo mono">Rede Vidal · IA</span>
      </div>
    </a>
    <a class="tela tela-dir" href="#case-victor-oliveira" tabindex="-1" aria-hidden="true">
      <div class="tela-in">
        <div class="browser"><div class="browser-barra"><i></i><i></i><i></i><span>Victor Oliveira</span></div>
          <Image src={vo2} alt="Site do professor Victor Oliveira" widths={[480, 760, 1100]} sizes="(max-width: 900px) 60vw, 38vw" loading="eager" />
        </div>
        <span class="tela-rotulo mono">Victor Oliveira</span>
      </div>
    </a>
  </div>
  <p class="wrap hero-legenda mono"><span>Projetos reais.</span> <span>Clientes reais.</span></p>
</section>

<style>
  .hero { position: relative; padding: calc(var(--header-h) + clamp(36px, 7vh, 88px)) 0 clamp(56px, 8vw, 96px); overflow: clip; isolation: isolate; }
  .hero-luz { position: absolute; inset: auto -20% -10% -20%; height: 75%; z-index: -1;
    background: radial-gradient(50% 55% at 50% 60%, rgb(201 169 110 / 0.2), rgb(201 169 110 / 0.05) 45%, transparent 70%);
    animation: luz-respira 9s ease-in-out infinite alternate; }
  .hero-texto { display: grid; gap: 26px; justify-items: start; }
  .hero h1 { font-size: clamp(2.9rem, 8vw, 7rem); letter-spacing: -0.05em; line-height: 0.95; max-width: 13ch; }
  .hero h1 .acento { padding-right: 0.06em; }
  .hero-sub { font-size: clamp(18px, 1.9vw, 22px); color: var(--muted); max-width: 34ch; line-height: 1.45; }
  .hero-linha { display: grid; gap: 26px; width: 100%; }
  .hero-acoes { display: flex; flex-wrap: wrap; gap: 12px; }
  @media (min-width: 1100px) {
    .hero-linha { grid-template-columns: 1fr auto; align-items: end; gap: 48px; margin-top: 4px; }
  }

  /* Palco: três telas reais */
  .palco { position: relative; margin: clamp(48px, 6vw, 84px) auto 0; width: min(100% - 2 * var(--gutter), 1320px); height: clamp(380px, 44vw, 620px); perspective: 2000px; }
  .tela { position: absolute; display: block; text-decoration: none; color: inherit; }
  .tela-in { position: relative; transform-style: preserve-3d; }
  .tela-rotulo { position: absolute; left: 0; bottom: -30px; color: var(--muted-2); font-size: 11px; transition: color 0.3s; }
  .tela:hover .tela-rotulo, .tela:focus-visible .tela-rotulo { color: var(--champagne); }
  .tela-esq { left: 0; top: 10%; width: 44%; z-index: 1; }
  .tela-dir { right: 0; top: 10%; width: 44%; z-index: 1; }
  .tela-centro { left: 50%; top: 0; width: clamp(210px, 21vw, 290px); margin-left: calc(clamp(210px, 21vw, 290px) / -2); z-index: 3; }
  .tela-dir .tela-rotulo { left: auto; right: 0; }
  .tela-centro .tela-rotulo { left: 50%; transform: translateX(-50%); white-space: nowrap; }

  /* Entrada cinematográfica: só transform e filtro, o conteúdo nunca fica invisível */
  .tela-esq .tela-in { transform: rotateY(16deg) rotateX(4deg); animation: entra-esq 1.6s var(--ease) both 0.15s; }
  .tela-dir .tela-in { transform: rotateY(-16deg) rotateX(4deg); animation: entra-dir 1.6s var(--ease) both 0.3s; }
  .tela-centro .tela-in { animation: entra-centro 1.5s var(--ease) both; }
  .tela .browser, .tela .phone { position: relative; }
  .tela .browser::after, .tela .phone::after { content: ''; position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
    background: linear-gradient(105deg, transparent 35%, rgb(255 244 220 / 0.16) 50%, transparent 65%); background-size: 260% 100%; background-position: 120% 0;
    animation: brilho 2.4s var(--ease) both 0.9s; }
  @keyframes entra-esq { from { transform: translate3d(-8%, 22%, -260px) rotateY(34deg) rotateX(18deg); filter: brightness(0.25); } }
  @keyframes entra-dir { from { transform: translate3d(8%, 22%, -260px) rotateY(-34deg) rotateX(18deg); filter: brightness(0.25); } }
  @keyframes entra-centro { from { transform: translate3d(0, 26%, -120px) rotateX(24deg) scale(0.9); filter: brightness(0.3); } }
  @keyframes brilho { from { background-position: 120% 0; } to { background-position: -40% 0; } }
  @keyframes luz-respira { from { opacity: 0.75; transform: scale(0.96); } to { opacity: 1; transform: scale(1.04); } }

  /* Ao rolar, as telas se abrem e se aproximam (onde o navegador suporta) */
  @supports (animation-timeline: scroll()) {
    .tela { animation-timing-function: linear; animation-fill-mode: both; animation-duration: auto; }
    .palco > .tela { animation-timeline: scroll(root); animation-range: 0 85vh; }
    .tela-esq { animation-name: abre-esq; }
    .tela-dir { animation-name: abre-dir; }
    .tela-centro { animation-name: abre-centro; }
    @keyframes abre-esq { to { transform: translate3d(-7%, -6%, 0) scale(1.07); } }
    @keyframes abre-dir { to { transform: translate3d(7%, -6%, 0) scale(1.07); } }
    @keyframes abre-centro { to { transform: translate3d(0, -9%, 0) scale(1.1); } }
  }

  .hero-legenda { margin-top: clamp(56px, 7vw, 96px); display: flex; gap: 8px; justify-content: center; color: var(--muted-2); }
  .hero-legenda span:last-child { color: var(--champagne); }

  @media (max-width: 900px) {
    .palco { height: auto; aspect-ratio: 1 / 1.18; max-width: 520px; perspective: 1400px; }
    .tela-esq, .tela-dir { width: 74%; top: 14%; }
    .tela-esq { left: -10%; }
    .tela-dir { right: -10%; top: 30%; }
    .tela-esq .tela-in { transform: rotate(-7deg); }
    .tela-dir .tela-in { transform: rotate(6deg); }
    .tela-centro { width: 54%; margin-left: -27%; top: 0; }
    .tela-rotulo { display: none; }
    @keyframes entra-esq { from { transform: translate3d(-10%, 24%, 0) rotate(-16deg); filter: brightness(0.25); } }
    @keyframes entra-dir { from { transform: translate3d(10%, 24%, 0) rotate(16deg); filter: brightness(0.25); } }
    @supports (animation-timeline: scroll()) {
      @keyframes abre-esq { to { transform: translate3d(-9%, -2%, 0) rotate(-3deg); } }
      @keyframes abre-dir { to { transform: translate3d(9%, -2%, 0) rotate(3deg); } }
      @keyframes abre-centro { to { transform: translate3d(0, -4%, 0) scale(1.04); } }
    }
  }
</style>
