---
import { Image } from 'astro:assets';
import Seta from './Seta.astro';
import { contato } from '../data/site';
import retrato from '../assets/joao/sobre-vinho.webp';
import estrada from '../assets/joao/treino.webp';
---
<section id="sobre" class="secao sobre" aria-labelledby="sobre-titulo">
  <div class="wrap sobre-grade">
    <div class="sobre-fotos">
      <figure class="foto-principal">
        <Image src={retrato} alt="João Victor, de camisa vinho, em pé." widths={[420, 640, 900]} sizes="(max-width: 900px) 80vw, 36vw" loading="lazy" />
      </figure>
      <figure class="foto-campo">
        <figcaption class="mono">No treino</figcaption>
        <Image src={estrada} alt="João Victor treinando na academia." widths={[320, 520, 760]} sizes="(max-width: 900px) 44vw, 20vw" loading="lazy" />
      </figure>
    </div>
    <div class="sobre-texto">
      <p class="eyebrow">Quem está por trás</p>
      <h2 id="sobre-titulo">João Victor<span class="ponto">.</span></h2>
      <p class="sobre-lead">Antes de programar, eu vendo. Passo o dia em farmácia, balcão e negociação, e é dali que vem o meu jeito de trabalhar: entender o problema do negócio antes de escolher a tecnologia.</p>
      <p>Hoje construo sites, sistemas e assistentes de IA para empresas que precisam de coisa funcionando, não de apresentação bonita.</p>
      <p class="fde">Trabalho no modelo que o mercado chama de <strong>Forward Deployed Engineer</strong>: entro na operação do cliente, entendo como ela funciona e coloco a solução rodando lá dentro.</p>
      <p class="sobre-local mono">Natal, RN · Projetos em todo o Brasil</p>
      <div class="fit">
        <p class="eyebrow">Educação Física · Calistenia</p>
        <h3>Também sou do treino.</h3>
        <p>Estudo Educação Física e meu foco é a calistenia, o treino com o peso do corpo. A ideia é ensinar mais gente a treinar assim, e é isso que eu levo para o @jotav.fit.</p>
        <a class="link-seta" href={contato.instagramFit} target="_blank" rel="noopener">Acompanhar o @jotav.fit<Seta /></a>
      </div>
    </div>
  </div>
</section>

<style>
  .sobre-grade { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: clamp(40px, 7vw, 110px); align-items: center; }
  .sobre-fotos { position: relative; padding: 0 22% 18% 0; }
  .foto-principal { margin: 0; border-radius: 22px; overflow: hidden; aspect-ratio: 3 / 4; background: var(--graphite); position: relative; }
  .foto-principal img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 20%; }
  .foto-etiqueta { position: absolute; left: 14px; top: 14px; z-index: 1; font-size: 10px; color: var(--carbon); background: var(--champagne); padding: 6px 9px; border-radius: 6px; }
  .foto-campo { position: absolute; right: 0; bottom: 0; width: 50%; margin: 0; border-radius: 16px; overflow: hidden; aspect-ratio: 3 / 4; border: 6px solid var(--carbon); }
  .foto-campo img { width: 100%; height: 100%; object-fit: cover; }
  .foto-campo figcaption { position: absolute; left: 10px; bottom: 10px; font-size: 10px; color: var(--ivory); background: rgb(11 11 11 / 0.6); padding: 5px 8px; border-radius: 6px; }
  .sobre-texto { display: grid; gap: 22px; justify-items: start; }
  .sobre h2 { font-size: clamp(3rem, 6.6vw, 5.8rem); letter-spacing: -0.055em; }
  .ponto { color: var(--champagne); }
  .sobre-lead { font-size: clamp(20px, 2vw, 25px); line-height: 1.42; letter-spacing: -0.015em; }
  .sobre-texto > p:not(.sobre-lead):not(.sobre-local) { color: var(--muted); font-size: 18px; max-width: 50ch; }
  .sobre-local { color: var(--muted-2); }
  .sobre-texto > p.fde { padding-left: 16px; border-left: 2px solid var(--champagne); font-size: 16.5px; }
  .fde strong { color: var(--ivory); font-weight: 600; }
  .fit { margin-top: 18px; padding: 26px 26px 24px; border: 1px solid var(--line-2); border-radius: 20px; background: linear-gradient(140deg, rgb(201 169 110 / 0.09), transparent 60%); display: grid; gap: 12px; justify-items: start; width: 100%; }
  .fit h3 { font-size: clamp(1.6rem, 2.6vw, 2.2rem); letter-spacing: -0.04em; }
  .fit > p:not(.eyebrow) { color: var(--muted); font-size: 17px; max-width: 52ch; }
  .fit .link-seta { margin-top: 6px; }
  .foto-campo figcaption { z-index: 1; }
  @supports (animation-timeline: view()) {
    .foto-principal img, .foto-campo, .foto-principal { animation-timing-function: linear; animation-fill-mode: both; animation-duration: auto; }
    .foto-principal img { animation-name: foto-zoom; }
    .foto-principal { animation-name: foto-cortina; }
    .foto-campo { animation-name: foto-sobe; }
    .sobre-fotos .foto-principal img, .sobre-fotos .foto-campo { animation-timeline: view(); }
    .sobre-fotos > .foto-principal { animation-timeline: view(); animation-range: entry 0% cover 40%; }
    @keyframes foto-cortina { from { clip-path: inset(30% 0 0 0 round 22px); } to { clip-path: inset(0 round 22px); } }
    @keyframes foto-sobe { from { transform: translateY(90px) rotate(5deg); } to { transform: translateY(-50px) rotate(-2deg); } }
    @keyframes foto-zoom { from { transform: scale(1.14); } to { transform: scale(1); } }
  }
  @media (max-width: 900px) { .sobre-grade { grid-template-columns: 1fr; } .sobre-fotos { max-width: 460px; } }
</style>
